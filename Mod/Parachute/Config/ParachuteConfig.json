{
  // Parachute settings. Edit the values, then restart the game or run
  // "chute reload" in the console. A missing or invalid value falls back to the
  // default shown in its comment and the game log says so. Speeds are m/s,
  // heights are meters, times are seconds unless the name says otherwise.

  // How the canopy is deployed: "jump" (one Jump press while in the air; the
  // press that starts a jump never counts), "key" or "both". Default: jump
  "deploy_input": "jump",

  // Optional direct key, a UnityEngine KeyCode name (for example "G"). Empty
  // turns it off. Avoid "F", which is the vanilla flashlight toggle.
  // Default: "" (off)
  "deploy_key": "",

  // After the canopy opens, Jump cannot cut it away for this long, so a quick
  // second press does not close it again. Allowed: 0 to 1000. Default: 250
  "cutaway_lockout_ms": 250,

  // true: switch to third person under the canopy, and back to the view you
  // last chose with the view key when it stows. false: stay in whichever view
  // you are in. Pressing the view key while the canopy is open is never
  // overridden. Default: true
  "auto_third_person": true,

  // How long after the canopy opens the switch to third person happens, in
  // milliseconds; 0 is at once. Allowed: 0 to 10000. Default: 500
  "third_person_after_ms": 500,

  // true: in third person under the canopy, use a vehicle-style camera,
  // centred behind you and further back. false: the game's over-the-shoulder
  // view. While aiming, the game's own view is kept. Default: true
  "chase_camera": true,

  // Height above your feet that the chase camera looks at, in meters (vehicles
  // use 1.8). Allowed: 0 to 5. Default: 1.8
  "chase_camera_height": 1.8,

  // Chase camera distance behind you when hanging still, in meters.
  // Allowed: 1 to 20. Default: 4
  "chase_camera_distance_min": 4,

  // Chase camera distance at glide_speed_forward, in meters; it is blended
  // between the two by your forward speed. Allowed: 1 to 20. Default: 6
  "chase_camera_distance_max": 6,

  // Clear air required below your feet before the canopy will open.
  // Allowed: 0 to 50. Default: 3.0
  "min_deploy_height": 3.0,

  // Descent speed with no input. Allowed: 1 to 30. Default: 4.0
  "fall_speed": 4.0,

  // Descent while holding Forward (dive). Allowed: 1 to 30. Default: 5.5
  "fall_speed_forward": 5.5,

  // Descent while holding Back (flare/glide). Allowed: 1 to 30. Default: 2.75
  "fall_speed_back": 2.75,

  // Forward speed with no input. Allowed: 0 to 20. Default: 4.0
  "glide_speed": 4.0,

  // Forward speed while holding Forward. Allowed: 0 to 25. Default: 6.0
  "glide_speed_forward": 6.0,

  // Forward speed while holding Back. Allowed: 0 to 20. Default: 1.5
  "glide_speed_back": 1.5,

  // What Left/Right do under the canopy: "strafe" slides sideways while you
  // keep facing where you look, "turn" rotates you. Default: strafe
  "left_right": "strafe",

  // Sideways speed while holding Left/Right in strafe mode. Allowed: 0 to 15.
  // Default: 3.0
  "strafe_speed": 3.0,

  // Turn rate from Left/Right in turn mode, in degrees per second.
  // Allowed: 10 to 360. Default: 75
  "turn_rate": 75,

  // How quickly the current speeds approach their targets, in m/s squared.
  // Allowed: 0.5 to 50. Default: 6.0
  "control_response": 6.0,

  // Seconds for the canopy to brake to the neutral descent and finish opening.
  // Allowed: 0.1 to 3. Default: 0.8
  "deploy_time": 0.8,

  // Seconds for the canopy to collapse when stowed. Allowed: 0.05 to 2.
  // Default: 0.4
  "stow_anim_time": 0.4,

  // true: press Jump again while open to cut away. Default: true
  "allow_cutaway": true,

  // Minimum wait after stowing before another deploy, in milliseconds.
  // Allowed: 0 to 5000. Default: 300
  "redeploy_cooldown_ms": 300,

  // Fall-damage immunity kept after touchdown, in milliseconds, to cover the
  // landing frame. Allowed: 0 to 3000. Default: 500
  "landing_grace_ms": 500,

  // Visual size of the canopy. Allowed: 0.25 to 3. Default: 1.0
  "canopy_scale": 1.0,

  // Canopy center above the player's feet, in meters. Allowed: 1 to 8.
  // Default: 3.2
  "canopy_height": 3.2,

  // Show the parachute pack on your back while the mod is installed in the
  // chest armor you are wearing: in third person, in the inventory preview and
  // on other players who have it. The canopy's riser straps start at the top
  // of the pack's shoulder straps. Default: true
  "show_pack": true,

  // Where the pack sits, in meters from the upper-spine bone, as
  // [right, up the spine, out of the chest]; negative z is behind you.
  // Each value -1 to 1. Default: [0, 0.06, -0.14]
  "pack_offset": [0, 0.06, -0.14],

  // Extra rotation of the pack in those same axes, in degrees.
  // Each value -180 to 180. Default: [0, 0, 0]
  "pack_rotation": [0, 0, 0],

  // Size of the pack. Allowed: 0.25 to 3. Default: 1.0
  "pack_scale": 1.0,

  // How far out the shoulder straps and chest strap come in front of you, to
  // fit the chest of the armor you wear. Above 1 moves them out from the body,
  // below 1 in toward it; the tops of the straps stay on the shoulders.
  // Allowed: 0.3 to 3. Default: 0.92
  "pack_chest_depth": 0.92,

  // Play the vanilla looping flutter sound while the canopy is open.
  // Default: true
  "play_flutter_loop": true,

  // Pitch of the flutter loop. 1.0 is the vanilla sound; lower is deeper and
  // flaps more slowly. Allowed: 0.3 to 1.5. Default: 0.7
  "flutter_pitch": 0.7,

  // Verbose logging and an on-screen readout. Default: false
  "debug": true
}
